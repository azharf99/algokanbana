# Mode aplikasi:
# - hybrid_safe : Login lokal/LMS read-only + database SQLite lokal cepat (0 POST mutasi ke server produksi Algonova)
# - seed_demo   : Offline murni dengan data simulasi lengkap untuk demo
# - production  : Mode siap produksi saat diadopsi manajemen Algonova
APP_MODE=hybrid_safe
PORT=8090
DB_PATH=./data/algokanbana.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=algokanbana-dev-secret-change-in-prod-2026

# Proteksi keras: blokir semua request POST/PUT/PATCH/DELETE mutasi ke domain Algonova/NanoKanbana
SAFE_READONLY_UPSTREAM=true
LMS_BASE_URL=https://lms.algonova.id
